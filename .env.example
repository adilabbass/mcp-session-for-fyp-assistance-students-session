# Optional. Without this the "Prepare summary with the LLM" menu option is disabled.
OPENAI_API_KEY=
# Optional override. Default is gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional. Without these the GitHub menu options are disabled.
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Command used to launch the official GitHub MCP server over stdio.
# See https://github.com/github/github-mcp-server for install instructions.
GITHUB_MCP_COMMAND=github-mcp-server
GITHUB_MCP_ARGS=stdio

# Directory the local server writes meeting_summary.md into.
# Kept configurable so tests can point it at a temp directory.
FYP_OUTPUT_DIR=output
